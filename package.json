{
  "name": "discflow",
  "version": "0.1.0",
  "private": true,
  "description": "LAN disc burning queue with a NestJS server and IMAPI2 burn agent",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"pnpm:dev:server\" \"pnpm:dev:client\"",
    "dev:server": "nest start --watch",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "pnpm run build:server && pnpm run build:client",
    "build:server": "nest build",
    "build:client": "vite build --config client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "dotenv": "^16.4.7",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
