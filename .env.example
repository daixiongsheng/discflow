# NestJS listen address (0.0.0.0 allows LAN clients to connect)
HOST=0.0.0.0
PORT=9000

# Store uploads and the durable job snapshot here.
DATA_DIR=./data

# "true" simulates a burner and is forced on non-Windows development machines.
BURN_SIMULATION=false
SIMULATION_DELAY_MS=120

# Windows burner settings.
BURN_DRIVE=
IMAPI2_SCRIPT=./windows/Invoke-Imapi2Burn.ps1
POWERSHELL_PATH=powershell.exe

# Per-request upload cap. The default is 8 GiB.
MAX_UPLOAD_BYTES=8589934592

# Remove staged source files after a successful burn.
CLEANUP_SOURCES_AFTER_SUCCESS=true

